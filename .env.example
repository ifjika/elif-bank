# ==============================================================================
# AethelCore Environment Configuration Template
# Related Documents: docs/SECURITY_GUIDE.md (Section 3) & docs/ARCHITECTURE.md
# IMPORTANT: Copy this file to '.env' in your local environment.
# NEVER commit production secrets or passwords to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Gateway Configuration (Gin Framework)
# ------------------------------------------------------------------------------
GATEWAY_HTTP_PORT=8080
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=15s

# ------------------------------------------------------------------------------
# 2. JWT & Security Secrets (Maker-Checker & Customer Auth)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ------------------------------------------------------------------------------
# 3. Database: MySQL 8.0 (Local) / TiDB Cloud Serverless (Online)
# Related Documents: docs/TSD.md (Section 1)
# ------------------------------------------------------------------------------
# For Local Docker:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aethel_bank_db
DB_USER=aethel_user
DB_PASSWORD=aethel_password_2026
DB_SSLMODE=false
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# Example TiDB Cloud Serverless Connection Parameters (Online):
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=aethel_bank_db
# DB_USER=xxxxxx.root
# DB_PASSWORD=your_tidb_cloud_password
# DB_SSLMODE=true

# ------------------------------------------------------------------------------
# 4. Redis Cache & Distributed Lock (Local / Upstash Cloud)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=aethel_redis_password_2026
REDIS_DB=0
