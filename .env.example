# ==============================================================================
# AethelCore Environment Configuration Template
# Dokumen Terkait: docs/SECURITY_GUIDE.md (Seksi 3) & docs/ARCHITECTURE.md
# PENTING: Salin file ini menjadi '.env' di lingkungan lokal Anda.
# JANGAN PERNAH men-commit nilai kredensial/password produksi asli ke git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Gateway Configuration (Gin Framework)
# ------------------------------------------------------------------------------
GATEWAY_HTTP_PORT=8080
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=15s

# ------------------------------------------------------------------------------
# 2. JWT & Security Secrets (Maker-Checker & Customer Auth)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ------------------------------------------------------------------------------
# 3. Database: MySQL 8.0 (Lokal) / TiDB Cloud Serverless (Online)
# Dokumen Terkait: docs/TSD.md (Seksi 1)
# ------------------------------------------------------------------------------
# Untuk Docker Lokal:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aethel_bank_db
DB_USER=aethel_user
DB_PASSWORD=aethel_password_2026
DB_SSLMODE=false
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# Contoh Format Connection String TiDB Cloud Serverless (Online):
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=aethel_bank_db
# DB_USER=xxxxxx.root
# DB_PASSWORD=your_tidb_cloud_password
# DB_SSLMODE=true

# ------------------------------------------------------------------------------
# 4. Redis Cache & Distributed Lock (Lokal / Upstash Cloud)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=aethel_redis_password_2026
REDIS_DB=0
